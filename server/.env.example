NODE_ENV=development
PORT=3443

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=gachagame
PGPASSWORD=changeme
PGDATABASE=gachagame

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# HTTPS (optional - if unset, server falls back to plain HTTP for local development)
TLS_KEY_PATH=
TLS_CERT_PATH=

# CORS
CORS_ORIGIN=*
